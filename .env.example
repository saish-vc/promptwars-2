# ─────────────────────────────────────────────────────────────
# LegiFlow Environment Configuration Example
# Copy this file to .env and fill in your values.
# ─────────────────────────────────────────────────────────────

# ── Server ────────────────────────────────────────────────────
PORT=8000
LOG_LEVEL=INFO
CORS_ORIGINS=http://localhost:5173,http://localhost:80
GUNICORN_WORKERS=4

# ── LLM Provider ──────────────────────────────────────────────
LLM_PROVIDER=groq
GROQ_API_KEY=your_groq_api_key_here
GROQ_MODEL=llama-3.1-70b-versatile
NIM_API_KEY=your_nim_api_key_here
NIM_BASE_URL=https://integrate.api.nvidia.com/v1

# ── Upload Limits ─────────────────────────────────────────────
MAX_UPLOAD_BYTES=10485760

# ── PostgreSQL ────────────────────────────────────────────────
POSTGRES_URL=postgresql+asyncpg://legiflow:legiflow@localhost:5432/legiflow

# ── Redis ─────────────────────────────────────────────────────
REDIS_URL=redis://localhost:6379/0
CACHE_TTL_SECONDS=86400

# ── S3 / MinIO Blob Storage ───────────────────────────────────
S3_ENDPOINT_URL=http://localhost:9000
S3_BUCKET_NAME=legiflow
S3_ACCESS_KEY=your_minio_or_s3_access_key
S3_SECRET_KEY=your_minio_or_s3_secret_key
# S3_REGION=us-east-1   # uncomment for AWS S3

# ── Vector Embeddings (optional) ──────────────────────────────
EMBEDDING_ENABLED=false
EMBEDDING_MODEL=nvidia/nv-embedqa-e5-v5
EMBEDDING_DIM=1024

# ── Fallback Mode (local dev without Docker) ──────────────────
ENABLE_FALLBACK_MODE=false
DATABASE_PATH=/tmp/legiflow.db

# ── Frontend ──────────────────────────────────────────────────
VITE_API_URL=
