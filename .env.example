# ─────────────────────────────────────────────────────────────
# LegiFlow Environment Configuration Example
# Copy this file to .env and fill in your values.
# Never commit your real .env to git — it is in .gitignore.
# ─────────────────────────────────────────────────────────────

# ── Server ────────────────────────────────────────────────────
PORT=8000
LOG_LEVEL=INFO
CORS_ORIGINS=http://localhost:5173,http://localhost:80
GUNICORN_WORKERS=4

# ── LLM Provider ──────────────────────────────────────────────
# Set LLM_PROVIDER to exactly "groq" or "nim".
# Only the matching API key needs to be set for the chosen provider.
# The other key is used for failover or embeddings (see below).
LLM_PROVIDER=groq

# ── Groq API key (required when LLM_PROVIDER=groq) ────────────
GROQ_API_KEY=your_groq_api_key_here
# Model name served by Groq. Confirmed working: openai/gpt-oss-120b
GROQ_MODEL=openai/gpt-oss-120b

# ── NVIDIA NIM API key (required when LLM_PROVIDER=nim) ───────
# Also required for vector embeddings regardless of LLM_PROVIDER.
NIM_API_KEY=your_nvidia_nim_api_key_here
NIM_MODEL=meta/llama-3.2-11b-vision-instruct
NIM_BASE_URL=https://integrate.api.nvidia.com/v1

# ── Upload Limits ─────────────────────────────────────────────
MAX_UPLOAD_BYTES=10485760

# ── PostgreSQL ────────────────────────────────────────────────
# For local dev with Docker Compose, leave as-is.
# For production, set to your managed PostgreSQL URL.
# NOTE: pgvector requires Supabase or Neon free tier —
#       Render's free Postgres does NOT include pgvector.
POSTGRES_URL=postgresql+asyncpg://legiflow:legiflow@localhost:5432/legiflow

# ── Redis ─────────────────────────────────────────────────────
REDIS_URL=redis://localhost:6379/0
CACHE_TTL_SECONDS=86400

# ── S3 / MinIO Blob Storage ───────────────────────────────────
# For local dev with Docker Compose MinIO:
S3_ENDPOINT_URL=http://localhost:9000
S3_BUCKET_NAME=legiflow
S3_ACCESS_KEY=your_minio_or_s3_access_key
S3_SECRET_KEY=your_minio_or_s3_secret_key
# For AWS S3, comment out S3_ENDPOINT_URL and set region:
# S3_ENDPOINT_URL=
# S3_REGION=us-east-1

# ── Vector Embeddings ─────────────────────────────────────────
# Set EMBEDDING_ENABLED=true to activate pgvector + BM25 hybrid RAG.
# Prerequisites:
#   1. NIM_API_KEY must be set (uses nvidia/nv-embedqa-e5-v5)
#   2. Postgres must have the pgvector extension installed
#   3. Upload documents after enabling — existing docs won't auto-embed
EMBEDDING_ENABLED=false
EMBEDDING_MODEL=nvidia/nv-embedqa-e5-v5
EMBEDDING_DIM=1024

# ── Fallback Mode (local dev without Docker) ──────────────────
# true  → SQLite + local disk + in-memory cache (no Docker needed)
# false → Requires Postgres + Redis + S3 to all be reachable
ENABLE_FALLBACK_MODE=false
DATABASE_PATH=/tmp/legiflow.db

# ── Frontend ──────────────────────────────────────────────────
# Leave empty for local dev (Vite proxy routes /api → localhost:8000).
# Set to the deployed backend URL for production Vercel builds.
VITE_API_URL=
